{%- comment -%}
  Renders the banner section within the header drawer.

  Accepts:
  - banner: {Array} Block objects of type 'banner'.

  Usage:
  {% render 'header-drawer-banner', banner: banner %}
{%- endcomment -%}

{%- if banner != blank -%}
  {%- for block in banner -%}
    <style>
      .menu-drawer__banner--{{ block.id }} {
        font-size: {{ block.settings.font_size_mobile }}px;
      }
      .menu-drawer__banner--{{ block.id }} a {
        color: {{ block.settings.text_color }};
      }
      @media screen and (min-width: 750px) {
        .menu-drawer__banner--{{ block.id }} {
          font-size: {{ block.settings.font_size_desktop }}px;
        }
      }
    </style>
    <div
      class="menu-drawer__banner menu-drawer__banner--{{ block.id }}"
      style="background-color: {{ block.settings.background_color }}; color: {{ block.settings.text_color }};"
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}">
      {%- endif -%}
      {{ block.settings.banner_text }}
      {%- if block.settings.link != blank -%}
        </a>
      {%- endif -%}
    </div>
  {%- endfor -%}
{%- endif -%} 